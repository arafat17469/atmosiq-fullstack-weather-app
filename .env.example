# Copy to .env and fill in values. Never commit .env with real secrets.
# PostgreSQL connection string used by Prisma.
# Example for a hosted database (Neon, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/atmosiq?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/atmosiq?schema=public"

# Optional: override Open-Meteo base URLs (defaults point at the public API).
# OPENMETEO_API_URL="https://api.open-meteo.com/v1"
# OPENMETEO_GEO_URL="https://geocoding-api.open-meteo.com/v1"
